# Public runtime configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Server-only configuration
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Leave empty for OpenAI. Set to the provider endpoint for an OpenAI-compatible API.
OPENAI_BASE_URL=
OPENAI_ROLEPLAY_MODEL=gpt-5.6-luna
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
OPENAI_MODEL_VERSION=2026-07-15
RUBRIC_VERSION=direction-a-v1
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development

# Dedicated Supabase project used only by `npm run test:rls`.
# The test creates two temporary users and removes them when it finishes.
SUPABASE_RLS_TEST_URL=
SUPABASE_RLS_TEST_ANON_KEY=
SUPABASE_RLS_TEST_SERVICE_ROLE_KEY=

# Never enable in real production; used only for local/E2E demo authentication.
ALLOW_DEMO_AUTH=false

# Optional: used to encrypt user-provided custom LLM API keys at rest.
# Any sufficiently long string works (it is hashed into a 32-byte AES key).
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
LLM_CONFIG_ENCRYPTION_KEY=
